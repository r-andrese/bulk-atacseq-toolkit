// ============================================================================
// Example Nextflow configuration for an SGE cluster (nf-core/atacseq v2.0).
// ============================================================================

params {
    config_profile_description = 'SGE cluster for nf-core/atacseq'
}

cleanup = false

executor {
    name = 'sge'
    queueSize = 100
    submitRateLimit = '10 sec'
}

singularity.runOptions = "-B ${HOME},${PWD}"

process {
    executor = 'sge'
    maxErrors = '-1'
    maxRetries = 3
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }

    cpus = 1
    time = 24.h
    penv = 'smp'

    // Request ~10% more memory than the task uses, divided per core.
    clusterOptions = {
        def actual_mem  = task.memory ? task.memory.toGiga() : 32
        def request_mem = (int) Math.ceil(actual_mem * 1.1)
        def cpus_val    = task.cpus ?: 1
        def mem_per_core = (int) Math.ceil(request_mem / cpus_val)
        def rt = task.time ? task.time.format('HH:mm:ss') : '24:00:00'
        return "-S /bin/bash -l tmem=${mem_per_core}G,h_vmem=${mem_per_core}G,h_rt=${rt}"
    }

    withLabel: 'process_single'      { cpus = 1; memory = 4.GB;   time = 6.h  }
    withLabel: 'process_low'         { cpus = 2; memory = 16.GB;  time = 12.h }
    withLabel: 'process_medium'      { cpus = 4; memory = 92.GB;  time = 24.h }
    withLabel: 'process_high'        { cpus = 8; memory = 128.GB; time = 48.h }
    withLabel: 'process_long'        { cpus = 4; memory = 80.GB;  time = 72.h }
    withLabel: 'process_high_memory' { cpus = 4; memory = 80.GB;  time = 24.h }
}
